# Backend CRM. Nunca commitear el .env real.

PORT=3001
DATABASE_URL=postgres://crm_padel:CAMBIAR@localhost:5432/crm_padel
SESSION_SECRET=genera-con-openssl-rand-base64-32
OIDC_ISSUER=https://auth.v3sports.es
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback
ZITADEL_PROJECT_ID=
# PAT de Zitadel (Management API) para alta/conciliación de profesores.
ZITADEL_PAT=
PUBLIC_URL=http://localhost:5175
# Móvil de la academia (E.164) para wa.me en la página de horarios familiares.
# FAMILIA_WHATSAPP_E164=+34600111222
# Datos de pago: solo salen en GET /api/familia/pago/:token/metodos (2.º paso)
# PAGO_BIZUM_TELEFONO=+34600111222
# PAGO_TRANSFERENCIA_IBAN=ES0000000000000000000000
# PAGO_TRANSFERENCIA_TITULAR=V3 Sports
# Caducidad de tokens (días). Pago más corto por datos bancarios.
# FAMILIA_PAGO_TTL_DIAS=45
# FAMILIA_HORARIO_TTL_DIAS=90
FOTOS_DIR=./data/fotos-alumnos
CORS_ORIGINS=http://localhost:5175,http://localhost:5173
